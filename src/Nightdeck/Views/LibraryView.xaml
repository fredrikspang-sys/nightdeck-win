<UserControl x:Class="Nightdeck.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button x:Name="BackBtn" DockPanel.Dock="Left" Content="&#xE76B;" Style="{StaticResource IconButton}" ToolTip="Back" AutomationProperties.Name="Back" Click="Back_Click" IsEnabled="False"/>
      <TextBlock x:Name="Heading" VerticalAlignment="Center" FontWeight="SemiBold" Text="Library" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Content="&#xE721;" Style="{StaticResource IconButton}" ToolTip="Search" AutomationProperties.Name="Search" Click="Search_Click" Margin="8,0,0,0"/>
      <TextBox x:Name="SearchBox" KeyDown="Search_Key" AutomationProperties.Name="Search library" ToolTip="Search library"/>
    </DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock x:Name="LibStatus" DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="&#xE768;" Style="{StaticResource IconButton}" ToolTip="Play now" AutomationProperties.Name="Play now" Click="PlayNow_Click"/>
        <Button Content="&#xE710;" Style="{StaticResource IconButton}" ToolTip="Add" AutomationProperties.Name="Add" Click="Add_Click"/>
        <Button Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="Refresh" AutomationProperties.Name="Refresh" Click="Refresh_Click"/>
      </StackPanel>
    </DockPanel>
    <ListBox x:Name="Items" MouseDoubleClick="Open_Click" KeyDown="List_Key">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Line}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
