<UserControl x:Class="Nightdeck.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock x:Name="QStatus" DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="&#xE768;" Style="{StaticResource IconButton}" ToolTip="Play" AutomationProperties.Name="Play" Click="Play_Click"/>
        <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Remove" AutomationProperties.Name="Remove" Click="Remove_Click"/>
        <Button Content="&#xE70E;" Style="{StaticResource IconButton}" ToolTip="Up" AutomationProperties.Name="Up" Click="Up_Click"/>
        <Button Content="&#xE70D;" Style="{StaticResource IconButton}" ToolTip="Down" AutomationProperties.Name="Down" Click="Down_Click"/>
        <Button Content="&#xE894;" Style="{StaticResource IconButton}" ToolTip="Clear" AutomationProperties.Name="Clear" Click="Clear_Click"/>
      </StackPanel>
    </DockPanel>
    <Grid>
      <ListBox x:Name="Songs" MouseDoubleClick="Play_Click" KeyDown="List_Key">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Line}" TextTrimming="CharacterEllipsis"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="Empty" Text="Queue is empty" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False" Visibility="Collapsed"/>
    </Grid>
  </DockPanel>
</UserControl>
