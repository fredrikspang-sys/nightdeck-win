<UserControl x:Class="Nightdeck.PlaylistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock x:Name="Info" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Presets" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="&#xE768;" Style="{StaticResource IconButton}" ToolTip="Play preset" AutomationProperties.Name="Play preset" Click="PlayPreset_Click"/>
          <Button Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="Refresh presets" AutomationProperties.Name="Refresh presets" Click="Reload_Click"/>
        </StackPanel>
        <ListBox x:Name="PresetList" DisplayMemberPath="Name" MouseDoubleClick="PlayPreset_Click"/>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Playlists" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button DockPanel.Dock="Right" Content="Save" Click="Save_Click" Margin="8,0,0,0"/>
          <TextBox x:Name="SaveName" AutomationProperties.Name="Playlist name" ToolTip="Playlist name"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Load" Click="Load_Click"/>
          <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Delete" AutomationProperties.Name="Delete" Click="Delete_Click"/>
          <Button Content="&#xE72C;" Style="{StaticResource IconButton}" ToolTip="Refresh playlists" AutomationProperties.Name="Refresh playlists" Click="Reload_Click"/>
        </StackPanel>
        <ListBox x:Name="PlaylistList" DisplayMemberPath="Line" MouseDoubleClick="Load_Click"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
