<UserControl x:Class="Nightdeck.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock x:Name="Info" DockPanel.Dock="Bottom" Margin="0,12,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="520" HorizontalAlignment="Left">
        <TextBlock Text="Player" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="Host" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="HostBox" Margin="0,4,0,8" AutomationProperties.Name="Host" ToolTip="Player host"/>
        <TextBlock Text="Port" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="PortBox" Width="120" HorizontalAlignment="Left" Margin="0,4,0,8" AutomationProperties.Name="Port" ToolTip="Player port"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button x:Name="DiscoverBtn" Content="Discover" Click="Discover_Click"/>
        </StackPanel>
        <ListBox x:Name="Found" MaxHeight="160" Margin="0,0,0,12" MouseDoubleClick="Found_Click" AutomationProperties.Name="Discovered players">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Name}"/>
                <Run Text="   "/>
                <Run Text="{Binding EndPoint}"/>
              </TextBlock>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Sleep" FontWeight="SemiBold" Margin="0,4,0,8"/>
        <CheckBox x:Name="FadeBox" Content="Fade volume when the sleep timer ends"/>
        <TextBlock Text="Fade length (seconds)" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
        <TextBox x:Name="FadeSeconds" Width="120" HorizontalAlignment="Left" Margin="0,4,0,8"/>
        <CheckBox x:Name="EndStopBox" Content="Stop instead of pause when the fade ends"/>

        <TextBlock Text="Window" FontWeight="SemiBold" Margin="0,12,0,8"/>
        <CheckBox x:Name="TrayBox" Content="Keep a tray icon with mini controls"/>
        <TextBlock Text="Volume dB offset" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        <TextBox x:Name="DbBox" Width="120" HorizontalAlignment="Left" Margin="0,4,0,12"/>

        <Button Content="Save" Click="Save_Click" HorizontalAlignment="Left"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
