<UserControl x:Class="Nightdeck.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Nightdeck">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border x:Name="CoverFrame" Grid.Row="0" Width="280" Height="280" HorizontalAlignment="Center"
            Background="{StaticResource SurfaceBrush}" CornerRadius="4">
      <Image x:Name="Cover" Stretch="Uniform"/>
    </Border>
    <DockPanel Grid.Row="1" LastChildFill="True">
      <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="ControlStack" Grid.Column="0" VerticalAlignment="Top">
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="56"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Elapsed" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="0:00"/>
            <Slider x:Name="Seek" Grid.Column="1" Style="{StaticResource TimelineSlider}" VerticalAlignment="Center" Margin="8,0"
                    Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                    PreviewMouseLeftButtonUp="Seek_Up" LostMouseCapture="Seek_Lost"
                    AutomationProperties.Name="Seek"/>
            <TextBlock x:Name="Duration" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Text="0:00"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <Button Content="&#xE892;" Click="Prev_Click" Style="{StaticResource TransportButton}"
                      ToolTip="Prev" AutomationProperties.Name="Prev"/>
              <Button x:Name="PlayBtn" Content="&#xE768;" Click="Play_Click" Style="{StaticResource TransportButton}"
                      ToolTip="Play" AutomationProperties.Name="Play"
                      BorderBrush="{StaticResource AccentBrush}"/>
              <Button x:Name="StopBtn" Content="&#xE71A;" Click="Stop_Click" Style="{StaticResource TransportButton}"
                      ToolTip="Stop" AutomationProperties.Name="Stop" IsEnabled="False"/>
              <Button Content="&#xE893;" Click="Next_Click" Style="{StaticResource TransportButton}"
                      ToolTip="Next" AutomationProperties.Name="Next"/>
              <Button x:Name="ShuffleBtn" Content="&#xE8B1;" Click="Shuffle_Click" Style="{StaticResource IconButton}"
                      Height="40" Width="40" Margin="0,0,6,6"
                      ToolTip="Shuffle" AutomationProperties.Name="Shuffle"/>
              <Button x:Name="RepeatBtn" Content="&#xF5E7;" Click="Repeat_Click" Style="{StaticResource IconButton}"
                      Height="40" Width="40" Margin="0,0,6,6"
                      ToolTip="Repeat Off" AutomationProperties.Name="Repeat Off"/>
            </StackPanel>
            <Grid x:Name="SleepSlot" Grid.Column="1">
              <Button x:Name="SleepBtn" Click="Sleep_Click" Height="40" MinWidth="40"
                      Padding="8,0" Margin="0,0,0,6" HorizontalAlignment="Left" HorizontalContentAlignment="Left"
                      MaxWidth="{Binding ActualWidth, ElementName=SleepSlot}"
                      ToolTip="Sleep off" AutomationProperties.Name="Sleep off">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="SleepGlyph" FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE708;"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="SleepCaption" Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center"
                             FontFamily="Segoe UI" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                </Grid>
              </Button>
            </Grid>
          </Grid>
        </StackPanel>
        <!-- Height follows the seek and transport rows. The wedge fills that, not the cover. -->
        <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top"
              Height="{Binding ActualHeight, ElementName=ControlStack}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28"/>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <local:VolumeWedge x:Name="VolWedge" Grid.Column="0" Level="{Binding Value, ElementName=Vol}"/>
            <Slider x:Name="Vol" Grid.Column="1" Style="{StaticResource VolumeSlider}"
                    Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                    IsMoveToPointEnabled="True" IsEnabled="False"
                    VerticalAlignment="Stretch" HorizontalAlignment="Center"
                    ToolTip="Volume" AutomationProperties.Name="Volume"/>
            <Button x:Name="MuteBtn" Grid.Column="2" Content="&#xE767;" Click="Mute_Click" Style="{StaticResource IconButton}"
                    Height="40" Width="40" Margin="6,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsEnabled="False" ToolTip="Mute" AutomationProperties.Name="Mute"/>
          </Grid>
          <TextBlock x:Name="VolText" Grid.Row="1" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,16,0,0">
          <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="—"/>
          <TextBlock x:Name="ArtistText" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="AlbumText" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
          <TextBlock x:Name="GroupText" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                     Visibility="Collapsed"/>
          <TextBlock x:Name="FormatText" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
